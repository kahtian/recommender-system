# recommendation function
def recommend_for_user(user_id, n_recommendations=5):
    # Add input validation
    if not isinstance(user_id, (int, str)):
        raise ValueError("User ID must be integer or string")
    
    # Handle cold start better
    if user_id not in user_item_matrix.index:
        # Return popular items with full details
        popular_items = final_data.groupby(['id', 'title', 'release_year', 'genres', 'description'])['rating'] \
                                .mean().sort_values(ascending=False).reset_index()
        top_popular = popular_items.head(n_recommendations)
        return top_popular.to_dict('records')
        
    if user_id not in user_item_matrix.index:
        return [{"title": "User not found in dataset"}]

    all_items = final_data['id'].unique()
    rated_items = user_item_matrix.loc[user_id].dropna().index
    items_to_predict = [item for item in all_items if item not in rated_items]
    
    if not items_to_predict:
        return [{"title": "No new recommendations available"}]
    
    predictions = [best_svd.predict(user_id, item_id) for item_id in items_to_predict]
    predictions.sort(key=lambda x: x.est, reverse=True)
    
    top_n_recommendations = predictions[:n_recommendations]
    
    # Get full details for each recommended movie
    recommended_items = []
    for pred in top_n_recommendations:
        movie_data = final_data[final_data['id'] == pred.iid]
        if not movie_data.empty:
            recommended_items.append({
                'title': movie_data['title'].values[0],
                'release_year': movie_data['release_year'].values[0],
                'genres': movie_data['genres'].values[0],
                'rating': round(pred.est, 1),
                'description': movie_data['description'].values[0]
            })
    
    return recommended_items

