# Content-Based Filtering: Precompute Similarities
content_features = final_data[['id', 'title', 'genres', 'production_countries', 
                             'release_year', 'description', 'type']].copy()
content_features['genres'] = content_features['genres'].apply(lambda x: literal_eval(x) if isinstance(x, str) else [])
content_features['production_countries'] = content_features['production_countries'].apply(lambda x: literal_eval(x) if isinstance(x, str) else [])

def compute_content_similarity(movie_id, user_genres, user_countries, weights=(0.5, 0.5)):
    """Normalized similarity computation"""
    if movie_id not in content_features['id'].values:
        return 0
    
    movie_row = content_features[content_features['id'] == movie_id].iloc[0]
    
    # Normalized genre similarity (0-1)
    genre_sim = (len(set(movie_row['genres']) & set(user_genres)) / 
                len(set(user_genres))) if user_genres else 0
    
    # Normalized country similarity (0-1)
    country_sim = (len(set(movie_row['production_countries']) & set(user_countries)) / 
                  len(set(user_countries))) if user_countries else 0
    
    # Scale to match CF rating range (1-5)
    return (weights[0] * genre_sim + weights[1] * country_sim) * 4 + 1  # Scales 0-1 to 1-5

def hybrid_recommend_for_user(user_id, n_recommendations=10, weight_cf=0.5, weight_cbf=0.5,
                            genre_filter=None, year_filter=None, type_filter=None,
                            country_filter=None, sim_weights=(0.5, 0.5)):
    """
    Hybrid recommendation with preserved structure but enhanced filtering
    """
    # Check if user exists
    if user_id not in final_data['user_id'].values and user_id != -1:
        print("User not found in dataset. Recommending top movies instead.")
        user_id = -1  # Treat as new user
    
    # Get user preferences (only for existing users)
    user_genres, user_countries = [], []
    if user_id != -1:
        user_movies = final_data[final_data['user_id'] == user_id]
        user_genres = list(set(g for genres in user_movies['genres'].apply(literal_eval) for g in genres))
        user_countries = list(set(c for countries in user_movies['production_countries'].apply(literal_eval) for c in countries))
    
    # Apply filters
    mask = pd.Series(True, index=final_data.index)
    
    if type_filter:
        mask &= (final_data['type'].str.lower() == type_filter.lower())
    
    if year_filter and isinstance(year_filter, list):
        if len(year_filter) != 2 or year_filter[0] > year_filter[1]:
            raise ValueError("Year range must be in format YYYY-YYYY")
    
    if genre_filter:
        if isinstance(genre_filter, str):
            genre_filter = [genre_filter]
        mask &= final_data['genres'].apply(
            lambda x: any(g.lower() in [gs.lower() for gs in literal_eval(x)] for g in genre_filter))
    
    if country_filter:
        if isinstance(country_filter, str):
            country_filter = [country_filter]
        mask &= final_data['production_countries'].apply(
            lambda x: any(c.lower() in [cs.lower() for cs in literal_eval(x)] for c in country_filter))
    
    all_items = final_data[mask]['id'].unique()
    
    # Generate recommendations
    predictions = []
    for item_id in all_items:
        try:
            # CF score (1-5 scale)
            cf_score = best_svd.predict(user_id, item_id).est
            
            # CBF score now on same 1-5 scale
            cbf_score = compute_content_similarity(item_id, user_genres, user_countries, sim_weights)
            
            # Hybrid score with balanced weights
            hybrid_score = (weight_cf * cf_score) + (weight_cbf * cbf_score)
            
            # Get movie details
            movie_data = final_data[final_data['id'] == item_id].iloc[0]
            
            predictions.append({
                'id': item_id,
                'title': movie_data['title'],
                'release_year': movie_data['release_year'],
                'genres': literal_eval(movie_data['genres']),
                'countries': literal_eval(movie_data['production_countries']),
                'description': movie_data['description'],
                'type': movie_data['type'],
                'hybrid_score': hybrid_score,
                'cf_score': cf_score,
                'cbf_score': cbf_score
            })
        except Exception as e:
            continue
    
    # Sort and return top recommendations
    predictions.sort(key=lambda x: x['hybrid_score'], reverse=True)
    return predictions[:n_recommendations]

